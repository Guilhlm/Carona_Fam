# ===========================================
# Carona FAM - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e ajuste os valores

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carona_fam

# Para uso com Docker (backend conecta ao container db)
DATABASE_URL=postgresql://postgres:postgres@db:5432/carona_fam?schema=public

# Para desenvolvimento local (banco rodando na máquina)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carona_fam?schema=public

# --- Backend ---
PORT=4000
NODE_ENV=development
JWT_SECRET=changeme-super-secret-use-strong-key-in-production
BCRYPT_SALT_ROUNDS=10

# Executar migrações ao iniciar (use true no Docker)
# RUN_MIGRATIONS=true

# --- Frontend ---
# URL base da API (use /api quando usar proxy do Vite ou nginx)
VITE_API_BASE_URL=/api

# Para desenvolvimento local com backend em outra porta
# VITE_API_BASE_URL=http://localhost:4000/api

ORS_API_KEY=