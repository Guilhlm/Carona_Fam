generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DRIVER
  ADMIN
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

enum RideStatus {
  WAITING_DRIVER
  DRIVER_ACCEPTED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RidePassengerStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CancellationActor {
  PASSENGER
  DRIVER
  ADMIN
  SYSTEM
}

enum ScheduledRideStatus {
  OPEN
  REQUESTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  ra           String?  @unique
  course       String?
  gender       Gender?
  age          Int?
  phone        String?
  cep          String?
  photoUrl     String?
  passwordHash String
  role         UserRole @default(USER)
  isAdmin      Boolean  @default(false)
  isBlocked    Boolean  @default(false)
  blockReason  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehiclesAsDriver   Vehicle[]
  ridesAsDriver           Ride[]           @relation("RideDriver")
  ridesAsRequester        Ride[]           @relation("RideRequester")
  scheduledRidesCreated   ScheduledRide[]
  scheduledRideJoins      ScheduledRidePassenger[]
  ridePassengers          RidePassenger[]
  reviewsGiven       Review[]        @relation("Reviewer")
  reviewsReceived    Review[]        @relation("Reviewed")
}

model Vehicle {
  id            String   @id @default(cuid())
  driverId      String
  brand         String?
  model         String?
  plate         String?  @unique
  year          Int?
  capacityTotal Int
  photoUrl      String?
  isDisabled    Boolean  @default(false)
  disabledReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver User  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rides  Ride[]
}

model Ride {
  id                  String             @id @default(cuid())
  requesterId         String
  driverId            String?
  vehicleId           String?
  origin              String
  destination         String
  originLat           Decimal?           @db.Decimal(10, 7)
  originLng           Decimal?           @db.Decimal(10, 7)
  destinationLat      Decimal?           @db.Decimal(10, 7)
  destinationLng      Decimal?           @db.Decimal(10, 7)
  distanceKm          Decimal?           @db.Decimal(6, 2)
  estimatedTimeMin    Int?
  estimatedValue      Decimal?           @db.Decimal(8, 2)
  actualValue         Decimal?           @db.Decimal(8, 2)
  departureAt         DateTime?
  arrivalAt           DateTime?
  availableSeats      Int                @default(1)
  status              RideStatus         @default(WAITING_DRIVER)
  requestedAt         DateTime           @default(now())
  acceptedAt          DateTime?
  arrivingAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  cancelledBy         CancellationActor?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  requester  User            @relation("RideRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  driver     User?           @relation("RideDriver", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  passengers RidePassenger[]
  stops      RideStop[]
  reviews    Review[]
  scheduledRide ScheduledRide?

  @@index([status])
  @@index([requesterId])
  @@index([driverId])
}

model ScheduledRide {
  id                 String              @id @default(cuid())
  creatorId          String
  origin             String?
  destination        String
  originLat          Decimal?            @db.Decimal(10, 7)
  originLng          Decimal?            @db.Decimal(10, 7)
  destinationLat     Decimal?            @db.Decimal(10, 7)
  destinationLng     Decimal?            @db.Decimal(10, 7)
  departureAt        DateTime
  returnAt           DateTime?
  passengers         Int                 @default(1)
  allowNewPassengers Boolean             @default(false)
  status             ScheduledRideStatus @default(OPEN)
  rideId             String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  creator           User                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  ride              Ride?                    @relation(fields: [rideId], references: [id], onDelete: SetNull)
  joinedPassengers  ScheduledRidePassenger[]

  @@index([creatorId])
  @@index([departureAt])
  @@index([allowNewPassengers])
  @@index([status])
}

model ScheduledRidePassenger {
  id              String   @id @default(cuid())
  scheduledRideId String
  passengerId     String
  pickupAddress   String
  pickupLat       Decimal  @db.Decimal(10, 7)
  pickupLng       Decimal  @db.Decimal(10, 7)
  createdAt       DateTime @default(now())

  scheduledRide ScheduledRide @relation(fields: [scheduledRideId], references: [id], onDelete: Cascade)
  passenger     User          @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([scheduledRideId, passengerId])
  @@index([scheduledRideId])
  @@index([passengerId])
}

model RideStop {
  id        String   @id @default(cuid())
  rideId    String
  ordering  Int
  address   String
  lat       Decimal? @db.Decimal(10, 7)
  lng       Decimal? @db.Decimal(10, 7)
  reachedAt DateTime?

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, ordering])
  @@index([rideId])
}

model RidePassenger {
  id          String             @id @default(cuid())
  rideId      String
  passengerId String
  status      RidePassengerStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  finishedAt  DateTime?

  ride      Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passenger User @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([rideId, passengerId])
  @@index([rideId])
  @@index([passengerId])
}

model Review {
  id         String   @id @default(cuid())
  rideId     String
  reviewerId String
  reviewedId String
  rating     Int
  comment    String?
  isDisabled Boolean  @default(false)
  disabledReason String?
  createdAt  DateTime @default(now())

  ride     Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewed User @relation("Reviewed", fields: [reviewedId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([reviewerId])
  @@index([reviewedId])
}
